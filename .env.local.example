# src/../.env.local (ریشه پروژه فرانت)
# ═══════════════════════════════════════════════
#   بیو کلاب - فرانت | Environment Variables
# ═══════════════════════════════════════════════

# ─── Mock Mode ───
# true  → فرانت از داده‌های Mock استفاده می‌کند (بدون بک‌اند)
# false → فرانت به بک‌اند واقعی متصل می‌شود
NEXT_PUBLIC_USE_MOCK=true

# ─── API Base URL ───
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ─── Media Base URL (تصاویر) ───
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8000

# ─── Arvan CDN (Production) ───
NEXT_PUBLIC_ARVAN_CDN_URL=

# ─── Site Domain ───
NEXT_PUBLIC_SITE_DOMAIN=http://localhost:3000