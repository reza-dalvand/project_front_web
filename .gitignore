# Capacitor

# Keep the native Android/iOS projects in Git if you want

# reproducible native builds and team collaboration.

# Do NOT ignore /android or /ios by default.

/.capacitor/
/.capacitor.config.*

# Android

# Local Android Studio / Gradle files

/android/.gradle/
/android/local.properties
/android/**/build/
/android/**/captures/
/android/**/.cxx/
/android/**/.externalNativeBuild/

# Android Studio

*.iml
.idea/
*.hprof

# iOS (if added later)

/ios/Pods/
/ios/build/
/ios/DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# misc

.DS_Store
*.pem

# debug

npm-debug.log*
yarn-debug.log*
